{
  "name": "iobroker.faikout-ac",
  "version": "0.1.992",
  "description": "ioBroker adapter for Faikout Daikin MQTT bridge",
  "author": "RWS <RWS@nurfuerspam.de>",
  "license": "MIT",
  "main": "build/src/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "homepage": "https://github.com/RaW79/ioBroker.faikout-ac",
  "repository": {
    "type": "git",
    "url": "https://github.com/RaW79/ioBroker.faikout-ac"
  },
  "bugs": {
    "url": "https://github.com/RaW79/ioBroker.faikout-ac/issues"
  },
  "keywords": [
    "ioBroker",
    "faikout",
    "daikin",
    "climate-control"
  ],
  "files": [
    "build/",
    "admin/",
    "io-package.json"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "watch": "tsc --build tsconfig.json --watch",
    "prebuild": "rimraf build",
    "test": "mocha test/*.test.js --exit",
    "test:package": "mocha test/package.test.js --exit",
    "test:integration": "mocha test/integration.js --timeout 60000 --exit",
    "lint": "eslint -c eslint.config.mjs .",
    "build-admin": "cd src-admin && npm install && npm run build"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "mqtt": "^5.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  }
}
